# --- Local (Docker pg-turbinas) ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=bd_web
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable

# --- RDS (us-east-1) ---
# PGHOST=turbinas-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
# PGSSLMODE=require
# PGDATABASE=turbinas
# PGUSER=app_turbinas
# PGPASSWORD=CAMBIA_ESTA_CLAVE

# Alternativa: DATABASE_URL=postgresql://app_turbinas:clave@host:5432/turbinas?sslmode=require

PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=25000

# Orígenes permitidos (Amplify + desarrollo local), separados por coma.
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://main.xxxxxxxx.amplifyapp.com

LOG_LEVEL=INFO
